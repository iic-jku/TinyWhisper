	(text "Raspberry Pi Pico H (RP2040) on two 1x20 sockets"
		(exclude_from_sim no)
		(at 16.51 44.45 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "364df3fe-ec86-5f98-99dc-ffa148bd37b3")
	)
	(text "GP0/GP1 UART to the chip, GP2 BUS_PICO, GP3 RST_REQ_N, GP6-9 gpio_in, GP10-13 gpio_out,\nGP14 CLK_OE, GP16-19 SPI0 to the PSRAM, GP26 VDD, GP27 IOVDD / 2, GP4/5 I2C (links not fitted)."
		(exclude_from_sim no)
		(at 17.78 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ff94b0b8-598a-55ec-94a8-7bfc254c6833")
	)
	(text "Clock: 56 MHz oscillator (R304 fitted) or SMA J301 (R305), 33 Ohm at the chip"
		(exclude_from_sim no)
		(at 128.27 26.67 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d7574336-b41c-5600-9e29-6e7c8f3d4b94")
	)
	(text "TW-E27: on 10 m the clock duty sets the I/Q balance. For a duty or bias trim drive J301\nfrom a generator (3.3 V CMOS, the reset flip-flop needs 2.0 V high), R305 in, R304 out."
		(exclude_from_sim no)
		(at 129.54 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "581591c9-e051-5b02-954f-a55af80a1b0b")
	)
	(text "Reset: rst_n released on a clock edge (TW-E25), held low without IOVDD (TW-E31)"
		(exclude_from_sim no)
		(at 128.27 102.87 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "588818e3-bd27-5cff-bf88-a9fe0392294a")
	)
	(text "The Pico raises RST_REQ_N after it has loaded the PSRAM, checked VDD on GP26 and set BUS_PICO low.\nRESET pulls D low. U301 runs from +3V3: its clock input needs 2.0 V high."
		(exclude_from_sim no)
		(at 129.54 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e3d0e680-8869-5b67-9e9a-f2eca578dc4c")
	)
	(text "UART: the Pico bridges USB to the chip, J302 for an external adapter"
		(exclude_from_sim no)
		(at 16.51 161.29 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7659925d-425c-5606-b42d-fa43c3cfa9d8")
	)
	(text "Host sends 2 stop bits (TW-E07). Firmware writes UART_TX_CPB = 485 (TW-E08).\nR310 limits the current an idle-high host pushes into an unpowered IOVDD."
		(exclude_from_sim no)
		(at 17.78 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "920b6ca3-8636-583e-8970-399763af6941")
	)
	(text "Links: the Pico drives gpio_in and reads gpio_out through 1k, I2C sniffer links not fitted, supply readback"
		(exclude_from_sim no)
		(at 128.27 179.07 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "85f316ce-e48f-529e-871f-f679c4019547")
	)
	(text "Bus owner default and spare Pico pins"
		(exclude_from_sim no)
		(at 293.37 26.67 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cd07c85c-f08f-5781-b930-a6a241006e04")
	)
