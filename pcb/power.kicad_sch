	(text "5 V from the Pico USB, 3.3 V board rail, IOVDD with its supervisor"
		(exclude_from_sim no)
		(at 21.59 34.29 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d7e605a4-8b73-5ddc-999e-0d179c0a0695")
	)
	(text "JP201 bridged: IOVDD from the 3.3 V board rail. Pull it for an ammeter, or feed a\ncurrent-limited bench supply into JP201 pin 2 (IOVDD) with GND on J201 pin 2.\nU202 raises PG_IO 200 ms after IOVDD exceeds 2.93 V: it enables the VDD regulator\nand releases the reset flip-flop (TW-E31)."
		(exclude_from_sim no)
		(at 22.86 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2608cdd7-cac4-506b-ad25-0e847aadaecb")
	)
	(text "VDD 1.5 V: low-noise LDO, on after IOVDD, discharged when IOVDD drops"
		(exclude_from_sim no)
		(at 21.59 110.49 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c1fe19ac-974b-5bb7-898e-cab6cfcff67e")
	)
	(text "JP202 bridged: VDD from the LP5907. Pull it for an ammeter, or feed a bench supply into JP202 pin 2\nafter IOVDD is up (TW-E31). Capacitance on the LP5907 output: C208 + C209 + C101 to C107 = 6.4 uF (10 uF max).\nCPU and IQ modulator share VDD on the die: keep it quiet (TW-E28)."
		(exclude_from_sim no)
		(at 22.86 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "17d3029b-177b-5ee0-b2f8-574569a3c644")
	)
