		(uuid "bdb60d2f-f329-52be-abc5-ed67625849fb")
	)
	(text "Fitted: R101 (pin 14 = VDD) and R103 (pin 15 = IOVSS lead to cavity), the bond plan of 2026-11-11.\nOlder plan (pin 14 = IOVSS, pin 15 = VDD): fit R102 and R104 instead.\nCheck on a loose part first: pin 15 to the exposed pad about 0 Ohm means the plan of 2026-11-11."
		(exclude_from_sim no)
		(at 22.86 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bf04a4d3-9632-50ab-ba4c-846df1d5d1f8")
	)
