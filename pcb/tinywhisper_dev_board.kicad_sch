	(text "SoC4219 (TinyWhisper), QFN-48 open-molded 7 x 7 mm, pins as on the package, pin 1 top left"
		(exclude_from_sim no)
		(at 128.27 77.47 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "98328f6d-aac3-566c-99ee-3d6b26c73525")
	)
	(text "VSS and IOVSS have no pad-to-lead wire: all 12 ground pads are downbonded to the paddle, and the leads 15, 27, 34, 46\nare bonded to it. The exposed pad (49) is the only ground of the die: solid paste and the via field of the footprint."
		(exclude_from_sim no)
		(at 129.54 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c4c5c26-a9a1-5cbf-9ac1-3ceb1bf2a641")
	)
	(text "Pins 14 and 15: both bond plans (TW-D03)"
