	(text "PSRAM and the chip-side buffers: the Pico owns the PSRAM while BUS_PICO is high (TW-E02), sram_ce inverted (TW-E01)"
		(exclude_from_sim no)
		(at 16.51 24.13 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "196dd968-23eb-5710-b457-a978ab1b4620")
	)
	(text "R402 to R404 and R406 sit at the chip: sclk runs at 28 MHz without pause, 125 kHz from the 10 m WSPR frequency (TW-E02).\nLoading: BUS_PICO high, the Pico writes the program over SPI0, then sets BUS_PICO low and raises RST_REQ_N.\nThe PSRAM needs 150 us after power-up before its first command."
		(exclude_from_sim no)
		(at 17.78 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fd757a9a-a792-517d-a7c8-1a44b750a590")
	)
	(text "Pico side of the PSRAM, so to the chip, SIO2 and SIO3"
		(exclude_from_sim no)
		(at 16.51 201.93 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "66467a64-29f1-5991-b95c-d2ffdd5b27cc")
	)
