# Cocotb Makefile for delta-sigma modulator testbench

MAKEFILE_DIR := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
MAKEFILE_PATH := $(realpath $(firstword $(MAKEFILE_LIST)))

# Variables
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
TOPLEVEL = dsmod
PYTHON_BIN ?= python3

.DEFAULT_GOAL := help

# Folder structure
SRC_DIR 		 := $(MAKEFILE_DIR)/../../../rtl
RESULTS_DIR 	 := $(MAKEFILE_DIR)/results
PSD_RESULTS_DIR  := $(RESULTS_DIR)/psd
SNDR_RESULTS_DIR := $(RESULTS_DIR)/sndr
RAMP_RESULTS_DIR := $(RESULTS_DIR)/ramp

# Baseline configuration regenerated by the `all` target
# Override with: make all DSMOD_ORDER=<1|2> DSMOD_OSR=<32|64|128|256>
DSMOD_ORDER ?= 2
DSMOD_OSR   ?= 64

# Source files
VERILOG_SOURCES = $(SRC_DIR)/dsmod.v

# Cocotb test module
COCOTB_TEST_MODULES = dsmod_cocotb

# Enable waveform dumping
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 100ps

# Icarus Verilog compile flags
COMPILE_ARGS += -g2012

# Override cocotb defaults so all generated artefacts carry the dsmod_ prefix
SIM_BUILD = $(RESULTS_DIR)/dsmod_sim_build
export COCOTB_RESULTS_FILE = $(RESULTS_DIR)/dsmod_results.xml

# Set simulation settings (timeunit, timeprecision, compile flags, etc.)
# Makefile.sim declares `all: sim` and its own `help`, and GNU make merges those into the targets
# defined below instead of replacing them. For `all` that means an unfiltered run of every test in
# dsmod_cocotb before the real recipe, with no DSMOD_RESULT_DIR set, which dumps dsmod_output.txt,
# dsmod_params.txt, dsmod_sndr.txt and dsmod_sndr_<amp>dB.txt into this directory and costs about
# ten minutes. For `help` it means Makefile.sim prints its own help and aborts the run. So skip the
# include for those two goals. The recursive `sim` calls in psd, sndr and ramp still pull it in.
COCOTB_SIM_GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),$(.DEFAULT_GOAL))
ifeq ($(filter all help,$(COCOTB_SIM_GOALS)),)
include $(shell cocotb-config --makefiles)/Makefile.sim
endif


# Help Target
help: ## Show this help message
	@echo 'Usage: make [target] [PYTHON_BIN=<python>]' 
	@echo ''
	@echo 'Available targets:'
	@grep -E '^[a-zA-Z0-9_.-]+:.*## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  %-20s %s\n", $$1, $$2}'
.PHONY: help
# ================================================================================================


# PSD Target
psd: ## Run PSD cocotb test, then plot PSD and analog output
	mkdir -p $(PSD_RESULTS_DIR)
	DSMOD_RESULT_DIR=$(PSD_RESULTS_DIR) $(MAKE) -f $(MAKEFILE_PATH) sim COCOTB_TEST_MODULES=dsmod_cocotb COCOTB_TEST_FILTER=dsmod_psd_test SIM_BUILD=$(PSD_RESULTS_DIR)/dsmod_sim_build COCOTB_RESULTS_FILE=$(PSD_RESULTS_DIR)/dsmod_results.xml
	DSMOD_RESULT_DIR=$(PSD_RESULTS_DIR) $(PYTHON_BIN) $(MAKEFILE_DIR)/dsmod_plot_psd.py
	DSMOD_RESULT_DIR=$(PSD_RESULTS_DIR) $(PYTHON_BIN) $(MAKEFILE_DIR)/dsmod_plot_analog.py
.PHONY: psd
# ================================================================================================


# SNDR Target
sndr: ## Run SNDR sweep and generate SNDR plot
	mkdir -p $(SNDR_RESULTS_DIR)
	DSMOD_RESULT_DIR=$(SNDR_RESULTS_DIR) $(PYTHON_BIN) $(MAKEFILE_DIR)/dsmod_sndr_sweep.py
	DSMOD_RESULT_DIR=$(SNDR_RESULTS_DIR) $(PYTHON_BIN) $(MAKEFILE_DIR)/dsmod_plot_sndr.py
.PHONY: sndr
# ================================================================================================


# Ramp Target
ramp: ## Run ramp cocotb test and generate ramp plot
	mkdir -p $(RAMP_RESULTS_DIR)
	DSMOD_RESULT_DIR=$(RAMP_RESULTS_DIR) $(MAKE) -f $(MAKEFILE_PATH) sim COCOTB_TEST_MODULES=dsmod_ramp_cocotb COCOTB_TEST_FILTER=dsmod_ramp_test SIM_BUILD=$(RAMP_RESULTS_DIR)/dsmod_sim_build COCOTB_RESULTS_FILE=$(RAMP_RESULTS_DIR)/dsmod_results.xml
	DSMOD_RESULT_DIR=$(RAMP_RESULTS_DIR) $(PYTHON_BIN) $(MAKEFILE_DIR)/dsmod_plot_ramp.py
.PHONY: ramp
# ================================================================================================


# Clean Targets
clean:: ## Remove all generated plots and simulator build artifacts
	rm -rf $(RESULTS_DIR)
.PHONY: clean

# Removes only the artefacts of one DSMOD_ORDER/DSMOD_OSR combination, so that the
# figures of the other combinations survive a single-configuration `all` run.
clean-config: ## Remove the generated files of the current DSMOD_ORDER/DSMOD_OSR combination only
	rm -f $(PSD_RESULTS_DIR)/dsmod_psd_ord$(DSMOD_ORDER)_osr$(DSMOD_OSR)_*.png
	rm -f $(PSD_RESULTS_DIR)/dsmod_analog_ord$(DSMOD_ORDER)_osr$(DSMOD_OSR)_*.png
	rm -f $(SNDR_RESULTS_DIR)/dsmod_sndr_ord$(DSMOD_ORDER)_osr$(DSMOD_OSR).png
	rm -f $(RAMP_RESULTS_DIR)/dsmod_ramp_ord$(DSMOD_ORDER)_osr$(DSMOD_OSR).png
	rm -rf $(PSD_RESULTS_DIR)/dsmod_sim_build $(SNDR_RESULTS_DIR)/dsmod_sim_build $(RAMP_RESULTS_DIR)/dsmod_sim_build
.PHONY: clean-config
# ================================================================================================


# All Target
all: ## Run all tests and generate all plots for one configuration (default DSMOD_ORDER=2, DSMOD_OSR=64)
	$(MAKE) DSMOD_ORDER=$(DSMOD_ORDER) DSMOD_OSR=$(DSMOD_OSR) clean-config
	$(MAKE) DSMOD_ORDER=$(DSMOD_ORDER) DSMOD_OSR=$(DSMOD_OSR) psd
	$(MAKE) DSMOD_ORDER=$(DSMOD_ORDER) DSMOD_OSR=$(DSMOD_OSR) sndr
	$(MAKE) DSMOD_ORDER=$(DSMOD_ORDER) DSMOD_OSR=$(DSMOD_OSR) ramp
.PHONY: all
# ================================================================================================


# All Runs Target
all_runs: ## Run all tests and generate all plots for all DSMOD orders and OSRs
	$(MAKE) clean
	for order in 1 2; do \
		for osr in 32 64 128 256; do \
			echo "[all_runs] Running ORDER=$$order OSR=$$osr"; \
			$(MAKE) DSMOD_ORDER=$$order DSMOD_OSR=$$osr psd || exit 1; \
			$(MAKE) DSMOD_ORDER=$$order DSMOD_OSR=$$osr sndr || exit 1; \
			$(MAKE) DSMOD_ORDER=$$order DSMOD_OSR=$$osr ramp || exit 1; \
		done; \
	done
.PHONY: all_runs
# ================================================================================================